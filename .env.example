# Sepanta Industrial Group — Phase 2 Environment Variables Example
# Copy to .env (production VPS) or .env.local (local dev) and fill strong secrets.

DATABASE_PATH=/app/data/sepanta.db
UPLOADS_DIR=/app/uploads

ADMIN_USERNAME=sepanta_admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# Must be at least 32 characters (generate via: openssl rand -hex 32)
SESSION_SECRET=REPLACE_WITH_64_CHAR_HEX_FROM_OPENSSL_RAND_HEX_32

# Set to true behind HTTPS on production VPS; false for local http://localhost:8080
COOKIE_SECURE=false

# SMS adapter: mock | kavenegar | smsir
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER=
FACTORY_SALES_PHONE=
